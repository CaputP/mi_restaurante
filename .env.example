POSTGRES_DB=vallecito
POSTGRES_USER=vallecito
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://vallecito:replace-with-a-strong-database-password@database:5432/vallecito

JWT_SECRET=replace-with-at-least-48-random-characters
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

NODE_ENV=development
FRONTEND_URL=http://localhost:8080
VITE_API_URL=/api/v1
LEGAL_BUSINESS_NAME=replace-with-registered-business-name
LEGAL_RUC=replace-with-ruc
LEGAL_ADDRESS=Chocco, Santiago - Cusco, Peru
LEGAL_EMAIL=replace-with-official-contact-email
LEGAL_PHONE=+51 994 744 356
DATA_BANK_REGISTRATION=replace-with-data-bank-registration-or-applicable-reference

EMAIL_MODE=console
MAIL_FROM=El Vallecito <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

RESERVATION_CLIENT_CANCELLATION_HOURS=24
BACKUP_ENABLED=false
BACKUP_DIRECTORY=/app/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

TRUST_PROXY_HOPS=1
LOG_LEVEL=info
