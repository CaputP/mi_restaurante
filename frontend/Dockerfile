FROM node:24-alpine AS build

WORKDIR /app

ARG VITE_API_URL
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_LEGAL_BUSINESS_NAME
ARG VITE_LEGAL_RUC
ARG VITE_LEGAL_ADDRESS
ARG VITE_LEGAL_EMAIL
ARG VITE_LEGAL_PHONE
ARG VITE_LEGAL_SECONDARY_PHONE
ARG VITE_DATA_BANK_REGISTRATION

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
ENV VITE_LEGAL_BUSINESS_NAME=${VITE_LEGAL_BUSINESS_NAME}
ENV VITE_LEGAL_RUC=${VITE_LEGAL_RUC}
ENV VITE_LEGAL_ADDRESS=${VITE_LEGAL_ADDRESS}
ENV VITE_LEGAL_EMAIL=${VITE_LEGAL_EMAIL}
ENV VITE_LEGAL_PHONE=${VITE_LEGAL_PHONE}
ENV VITE_LEGAL_SECONDARY_PHONE=${VITE_LEGAL_SECONDARY_PHONE}
ENV VITE_DATA_BANK_REGISTRATION=${VITE_DATA_BANK_REGISTRATION}

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
