model Resena {
  id         String @id @default(uuid()) @db.Uuid
  ventaId    String @unique @map("venta_id") @db.Uuid
  clienteId  String @map("cliente_id") @db.Uuid
  sucursalId String @map("sucursal_id") @db.Uuid

  calificacion  Int
  comentario    String @db.Text
  nombrePublico String @map("nombre_publico") @db.VarChar(100)

  consentimientoPublicacionAt DateTime     @map("consentimiento_publicacion_at") @db.Timestamptz(3)
  estado                      EstadoResena @default(PENDIENTE)
  destacada                   Boolean      @default(false)

  moderadaPorId    String?   @map("moderada_por_id") @db.Uuid
  moderadaAt       DateTime? @map("moderada_at") @db.Timestamptz(3)
  motivoModeracion String?   @map("motivo_moderacion") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  venta       Venta    @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  cliente     Usuario  @relation("ResenasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  sucursal    Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  moderadaPor Usuario? @relation("ResenasModeradasPor", fields: [moderadaPorId], references: [id], onDelete: Restrict)

  @@index([estado, destacada, createdAt])
  @@index([sucursalId, estado, createdAt])
  @@index([clienteId, createdAt])
  @@map("resena")
}

// ======================================================
// NOTIFICACIONES
// ======================================================

model Notificacion {
  id         String  @id @default(uuid()) @db.Uuid
  sucursalId String? @map("sucursal_id") @db.Uuid
