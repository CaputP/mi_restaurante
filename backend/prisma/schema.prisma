// ======================================================
// ORGANIZACIÓN Y SUCURSALES
// ======================================================

model Sucursal {
  id          String         @id @default(uuid()) @db.Uuid
  codigo      String         @unique @db.VarChar(20)
  nombre      String         @db.VarChar(150)
  razonSocial String?        @map("razon_social") @db.VarChar(200)
  ruc         String?        @db.VarChar(20)
  direccion   String         @db.VarChar(250)
  telefono    String?        @db.VarChar(30)
  correo      String?        @db.VarChar(160)
  zonaHoraria String         @default("America/Lima") @map("zona_horaria") @db.VarChar(60)
  estado      EstadoRegistro @default(ACTIVO)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  zonas                  Zona[]
  horariosAtencion       HorarioAtencion[]
  bloqueosDisponibilidad BloqueoDisponibilidad[]
  usuarios               UsuarioSucursal[]
  productos              ProductoSucursal[]
  reservas               Reserva[]
  pedidos                Pedido[]
  comandas               Comanda[]
  cajas                  Caja[]
  ventas                 Venta[]
  gastos                 Gasto[]

  programasFidelizacion ProgramaFidelizacion[]
  promociones           Promocion[]
  configuraciones       ConfiguracionSistema[]
  notificaciones        Notificacion[]
  resenas               Resena[]
  auditorias            Auditoria[]
  correlativos          Correlativo[]
  respaldos             Respaldo[]
  reclamosConsumidor    ReclamoConsumidor[]

  @@index([estado])
  @@map("sucursal")
}

model Zona {
  id                   String         @id @default(uuid()) @db.Uuid
  sucursalId           String         @map("sucursal_id") @db.Uuid
  nombre               String         @db.VarChar(120)
  descripcion          String?        @db.Text
  capacidadReferencial Int?           @map("capacidad_referencial")
  estado               EstadoRegistro @default(ACTIVO)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  sucursal               Sucursal                @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  bloqueosDisponibilidad BloqueoDisponibilidad[]
  reservas               Reserva[]
  pedidos                Pedido[]

  @@unique([sucursalId, nombre])
  @@index([sucursalId, estado])
  @@map("zona")
}

model HorarioAtencion {
  id         String    @id @default(uuid()) @db.Uuid
  sucursalId String    @map("sucursal_id") @db.Uuid
  diaSemana  DiaSemana @map("dia_semana")
  horaInicio DateTime  @map("hora_inicio") @db.Time(0)
  horaFin    DateTime  @map("hora_fin") @db.Time(0)
  activo     Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@unique([sucursalId, diaSemana, horaInicio, horaFin])
  @@index([sucursalId, diaSemana, activo])
  @@map("horario_atencion")
}

model BloqueoDisponibilidad {
  id          String         @id @default(uuid()) @db.Uuid
  sucursalId  String         @map("sucursal_id") @db.Uuid
  zonaId      String?        @map("zona_id") @db.Uuid
  creadoPorId String         @map("creado_por_id") @db.Uuid
  fechaInicio DateTime       @map("fecha_inicio") @db.Timestamptz(3)
  fechaFin    DateTime       @map("fecha_fin") @db.Timestamptz(3)
  motivo      String         @db.Text
  estado      EstadoRegistro @default(ACTIVO)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal  Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  zona      Zona?    @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  creadoPor Usuario  @relation("BloqueosCreados", fields: [creadoPorId], references: [id], onDelete: Restrict)

  @@index([sucursalId, fechaInicio, fechaFin])
  @@index([zonaId, fechaInicio, fechaFin])
  @@index([estado])
  @@map("bloqueo_disponibilidad")
}

// ======================================================
// ROLES Y PERMISOS
// ======================================================

model Rol {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique @db.VarChar(50)
  nombre      String  @db.VarChar(100)
  descripcion String? @db.Text
  activo      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuarios       Usuario[]
  permisos       RolPermiso[]
  notificaciones Notificacion[]

  @@index([activo])
  @@map("rol")
}

model Permiso {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique @db.VarChar(80)
  nombre      String  @db.VarChar(120)
  descripcion String? @db.Text
  modulo      String  @db.VarChar(80)
  activo      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolPermiso[]

  @@index([modulo, activo])
  @@map("permiso")
}

model RolPermiso {
  rolId     String @map("rol_id") @db.Uuid
  permisoId String @map("permiso_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
  @@map("rol_permiso")
}

// ======================================================
// USUARIOS
// ======================================================

model Usuario {
  id                   String         @id @default(uuid()) @db.Uuid
  rolId                String         @map("rol_id") @db.Uuid
  nombres              String         @db.VarChar(120)
  apellidos            String         @db.VarChar(150)
  telefono             String?        @db.VarChar(30)
  correo               String         @unique @db.VarChar(160)
  passwordHash         String?        @map("password_hash") @db.VarChar(255)
  googleId             String?        @unique @map("google_id") @db.VarChar(255)
  proveedorAuth        ProveedorAuth  @default(LOCAL) @map("proveedor_auth")
  googleSubject        String?        @unique @map("google_subject") @db.VarChar(255)
  estado               EstadoRegistro @default(ACTIVO)
  correoVerificado     Boolean        @default(false) @map("correo_verificado")
  ultimoAcceso         DateTime?      @map("ultimo_acceso") @db.Timestamptz(3)
  sessionVersion       Int            @default(0) @map("session_version")
  terminosAceptadosAt  DateTime?      @map("terminos_aceptados_at") @db.Timestamptz(3)
  terminosVersion      String?        @map("terminos_version") @db.VarChar(30)
  privacidadAceptadaAt DateTime?      @map("privacidad_aceptada_at") @db.Timestamptz(3)
  privacidadVersion    String?        @map("privacidad_version") @db.VarChar(30)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  rol             Rol                     @relation(fields: [rolId], references: [id], onDelete: Restrict)
  sucursales      UsuarioSucursal[]
  bloqueosCreados BloqueoDisponibilidad[] @relation("BloqueosCreados")

  stocksDiariosCreados StockDiario[]          @relation("StockDiarioCreadoPor")
  movimientosStock     MovimientoInventario[] @relation("MovimientosInventarioUsuario")

  reservasComoCliente     Reserva[]          @relation("ReservasCliente")
  reservasAprobadas       Reserva[]          @relation("ReservasAprobadas")
  reservasCanceladas      Reserva[]          @relation("ReservasCanceladas")
  pagosReservaRegistrados PagoReserva[]      @relation("PagosReservaRegistrados")
  pagosReservaConfirmados PagoReserva[]      @relation("PagosReservaConfirmados")
  historialReservas       HistorialReserva[] @relation("HistorialReservaUsuario")

  pedidosComoCliente Pedido[] @relation("PedidosCliente")
  pedidosCreados     Pedido[] @relation("PedidosVendedor")
  pedidosComoMozo    Pedido[] @relation("PedidosMozo")
  pedidosCancelados  Pedido[] @relation("PedidosCancelados")

  comandasProcesadas Comanda[]       @relation("ComandasProcesadas")
  entregasRealizadas EntregaPedido[] @relation("EntregasMozo")

  ventasComoCliente  Venta[]  @relation("VentasCliente")
  ventasComoVendedor Venta[]  @relation("VentasVendedor")
  ventasAnuladas     Venta[]  @relation("VentasAnuladasPor")
  resenasComoCliente Resena[] @relation("ResenasCliente")
  resenasModeradas   Resena[] @relation("ResenasModeradasPor")

  cajasComoVendedor Caja[] @relation("CajasVendedor")
  cajasAbiertas     Caja[] @relation("CajasAbiertasPor")
  cajasCerradas     Caja[] @relation("CajasCerradasPor")

  gastosRegistrados Gasto[] @relation("GastosRegistradosPor")
  gastosAnulados    Gasto[] @relation("GastosAnuladosPor")

  programasFidelizacionCreados ProgramaFidelizacion[] @relation("ProgramasFidelizacionCreados")
  promocionesCreadas           Promocion[]            @relation("PromocionesCreadas")

  progresosFidelizacion             ProgresoFidelizacion[]   @relation("ProgresoFidelizacionCliente")
  premiosObtenidos                  PremioCliente[]          @relation("PremiosCliente")
  premiosCanjeados                  PremioCliente[]          @relation("PremiosCanjeadosPor")
  movimientosFidelizacionCliente    MovimientoFidelizacion[] @relation("MovimientosFidelizacionCliente")
  movimientosFidelizacionRevertidos MovimientoFidelizacion[] @relation("MovimientosFidelizacionRevertidosPor")

  configuracionesActualizadas ConfiguracionSistema[] @relation("ConfiguracionesActualizadasPor")
  notificaciones              Notificacion[]         @relation("NotificacionesUsuario")
  auditorias                  Auditoria[]            @relation("AuditoriasUsuario")
  respaldosSolicitados        Respaldo[]             @relation("RespaldosSolicitadosPor")

  canjesPremioCliente    CanjePremioCliente[] @relation("CanjesPremioCliente")
  canjesPremioRealizados CanjePremioCliente[] @relation("CanjesPremioRealizadosPor")
  canjesPremioRevertidos CanjePremioCliente[] @relation("CanjesPremioRevertidosPor")

  tokensVerificacionCorreo TokenVerificacionCorreo[]
  tokensRecuperacion       TokenRecuperacionPassword[]
  reclamosRespondidos      ReclamoConsumidor[]         @relation("ReclamosRespondidosPor")

  @@index([rolId, estado])
  @@index([apellidos, nombres])
  @@map("usuario")
}

model UsuarioSucursal {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  sucursalId  String    @map("sucursal_id") @db.Uuid
  activo      Boolean   @default(true)
  fechaInicio DateTime  @default(now()) @map("fecha_inicio") @db.Date
  fechaFin    DateTime? @map("fecha_fin") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, sucursalId])
  @@index([sucursalId, activo])
  @@map("usuario_sucursal")
}

// ======================================================
// CATÁLOGO DE PRODUCTOS
// ======================================================

model Categoria {
  id          String         @id @default(uuid()) @db.Uuid
  nombre      String         @unique @db.VarChar(120)
  descripcion String?        @db.Text
  estado      EstadoRegistro @default(ACTIVO)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  productos Producto[]

  @@index([estado])
  @@map("categoria")
}

model UnidadMedida {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique @db.VarChar(30)
  nombre      String  @db.VarChar(80)
  abreviatura String  @db.VarChar(15)
  decimales   Int     @default(0)
  activo      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  productos Producto[]

  @@index([activo])
  @@map("unidad_medida")
}

model Producto {
  id                  String             @id @default(uuid()) @db.Uuid
  categoriaId         String             @map("categoria_id") @db.Uuid
  unidadMedidaId      String             @map("unidad_medida_id") @db.Uuid
  codigo              String             @unique @db.VarChar(40)
  nombre              String             @db.VarChar(150)
  descripcion         String?            @db.Text
  tipoStock           TipoStock          @map("tipo_stock")
  requierePreparacion Boolean            @default(false) @map("requiere_preparacion")
  destinoPreparacion  DestinoPreparacion @default(NINGUNO) @map("destino_preparacion")
  permiteCortesia     Boolean            @default(false) @map("permite_cortesia")
  estado              EstadoRegistro     @default(ACTIVO)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  categoria    Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  unidadMedida UnidadMedida       @relation(fields: [unidadMedidaId], references: [id], onDelete: Restrict)
  sucursales   ProductoSucursal[]

  programasComoPremio ProgramaFidelizacion[] @relation("ProductoPremioPrograma")
  premiosEmitidos     PremioCliente[]        @relation("ProductoPremioEmitido")
  promociones         PromocionProducto[]

  @@index([categoriaId, estado])
  @@index([nombre])
  @@index([tipoStock])
  @@map("producto")
}

model ProductoSucursal {
  id              String         @id @default(uuid()) @db.Uuid
  productoId      String         @map("producto_id") @db.Uuid
  sucursalId      String         @map("sucursal_id") @db.Uuid
  precioVenta     Decimal        @map("precio_venta") @db.Decimal(12, 2)
  stockMinimo     Decimal        @default(0) @map("stock_minimo") @db.Decimal(12, 3)
  disponibleVenta Boolean        @default(true) @map("disponible_venta")
  estado          EstadoRegistro @default(ACTIVO)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  producto        Producto               @relation(fields: [productoId], references: [id], onDelete: Restrict)
  sucursal        Sucursal               @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  stockPermanente StockPermanente?
  stocksDiarios   StockDiario[]
  movimientos     MovimientoInventario[]
  detallesReserva DetalleReserva[]
  detallesPedido  DetallePedido[]
  detallesVenta   DetalleVenta[]

  @@unique([productoId, sucursalId])
  @@index([sucursalId, disponibleVenta, estado])
  @@index([productoId])
  @@map("producto_sucursal")
}

// ======================================================
// INVENTARIO
// ======================================================

model StockPermanente {
  id                   String  @id @default(uuid()) @db.Uuid
  productoSucursalId   String  @unique @map("producto_sucursal_id") @db.Uuid
  cantidadActual       Decimal @default(0) @map("cantidad_actual") @db.Decimal(12, 3)
  cantidadComprometida Decimal @default(0) @map("cantidad_comprometida") @db.Decimal(12, 3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  productoSucursal ProductoSucursal @relation(fields: [productoSucursalId], references: [id], onDelete: Restrict)

  @@map("stock_permanente")
}

model StockDiario {
  id                   String   @id @default(uuid()) @db.Uuid
  productoSucursalId   String   @map("producto_sucursal_id") @db.Uuid
  creadoPorId          String   @map("creado_por_id") @db.Uuid
  fecha                DateTime @db.Date
  cantidadInicial      Decimal  @default(0) @map("cantidad_inicial") @db.Decimal(12, 3)
  cantidadActual       Decimal  @default(0) @map("cantidad_actual") @db.Decimal(12, 3)
  cantidadComprometida Decimal  @default(0) @map("cantidad_comprometida") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  productoSucursal ProductoSucursal @relation(fields: [productoSucursalId], references: [id], onDelete: Restrict)
  creadoPor        Usuario          @relation("StockDiarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)

  @@unique([productoSucursalId, fecha])
  @@index([fecha])
  @@index([creadoPorId])
  @@map("stock_diario")
}

model MovimientoInventario {
  id                 String                   @id @default(uuid()) @db.Uuid
  productoSucursalId String                   @map("producto_sucursal_id") @db.Uuid
  usuarioId          String                   @map("usuario_id") @db.Uuid
  tipoMovimiento     TipoMovimientoInventario @map("tipo_movimiento")
  cantidad           Decimal                  @db.Decimal(12, 3)
  cantidadAnterior   Decimal                  @map("cantidad_anterior") @db.Decimal(12, 3)
  cantidadResultante Decimal                  @map("cantidad_resultante") @db.Decimal(12, 3)
  costoUnitario      Decimal?                 @map("costo_unitario") @db.Decimal(12, 2)
  costoTotal         Decimal?                 @map("costo_total") @db.Decimal(12, 2)
  motivo             String                   @db.Text
  referenciaTipo     String?                  @map("referencia_tipo") @db.VarChar(60)
  referenciaId       String?                  @map("referencia_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  productoSucursal ProductoSucursal @relation(fields: [productoSucursalId], references: [id], onDelete: Restrict)
  usuario          Usuario          @relation("MovimientosInventarioUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([productoSucursalId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([tipoMovimiento, createdAt])
  @@index([referenciaTipo, referenciaId])
  @@map("movimiento_inventario")
}

// ======================================================
// RESERVAS Y EVENTOS
// ======================================================

model Reserva {
  id                String        @id @default(uuid()) @db.Uuid
  codigo            String        @db.VarChar(30)
  clienteId         String        @map("cliente_id") @db.Uuid
  sucursalId        String        @map("sucursal_id") @db.Uuid
  zonaId            String        @map("zona_id") @db.Uuid
  tipoReserva       TipoReserva   @map("tipo_reserva")
  fechaReserva      DateTime      @map("fecha_reserva") @db.Date
  horaReserva       DateTime      @map("hora_reserva") @db.Time(0)
  duracionMinutos   Int           @default(120) @map("duracion_minutos")
  cantidadPersonas  Int           @map("cantidad_personas")
  nombreEvento      String?       @map("nombre_evento") @db.VarChar(180)
  observaciones     String?       @db.Text
  totalEstimado     Decimal       @default(0) @map("total_estimado") @db.Decimal(12, 2)
  adelantoRequerido Decimal       @default(0) @map("adelanto_requerido") @db.Decimal(12, 2)
  adelantoPagado    Decimal       @default(0) @map("adelanto_pagado") @db.Decimal(12, 2)
  saldoEstimado     Decimal       @default(0) @map("saldo_estimado") @db.Decimal(12, 2)
  estado            EstadoReserva @default(SOLICITADA)

  aprobadoPorId   String?   @map("aprobado_por_id") @db.Uuid
  fechaAprobacion DateTime? @map("fecha_aprobacion") @db.Timestamptz(3)

  canceladoPorId            String?   @map("cancelado_por_id") @db.Uuid
  fechaCancelacion          DateTime? @map("fecha_cancelacion") @db.Timestamptz(3)
  motivoCancelacion         String?   @map("motivo_cancelacion") @db.Text
  penalidadCancelacion      Decimal   @default(0) @map("penalidad_cancelacion") @db.Decimal(12, 2)
  montoDevuelto             Decimal   @default(0) @map("monto_devuelto") @db.Decimal(12, 2)
  politicaReservaAceptadaAt DateTime? @map("politica_reserva_aceptada_at") @db.Timestamptz(3)
  politicaReservaVersion    String?   @map("politica_reserva_version") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente      Usuario  @relation("ReservasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  zona         Zona     @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  aprobadoPor  Usuario? @relation("ReservasAprobadas", fields: [aprobadoPorId], references: [id], onDelete: Restrict)
  canceladoPor Usuario? @relation("ReservasCanceladas", fields: [canceladoPorId], references: [id], onDelete: Restrict)

  detalles  DetalleReserva[]
  pagos     PagoReserva[]
  historial HistorialReserva[]
  pedido    Pedido?

  @@unique([sucursalId, codigo])
  @@index([clienteId, createdAt])
  @@index([sucursalId, fechaReserva, estado])
  @@index([zonaId, fechaReserva, horaReserva])
  @@index([estado])
  @@map("reserva")
}

model DetalleReserva {
  id                   String               @id @default(uuid()) @db.Uuid
  reservaId            String               @map("reserva_id") @db.Uuid
  productoSucursalId   String               @map("producto_sucursal_id") @db.Uuid
  nombreProducto       String               @map("nombre_producto") @db.VarChar(150)
  cantidadSolicitada   Decimal              @map("cantidad_solicitada") @db.Decimal(12, 3)
  cantidadAprobada     Decimal              @default(0) @map("cantidad_aprobada") @db.Decimal(12, 3)
  cantidadComprometida Decimal              @default(0) @map("cantidad_comprometida") @db.Decimal(12, 3)
  precioReservado      Decimal              @map("precio_reservado") @db.Decimal(12, 2)
  subtotal             Decimal              @default(0) @db.Decimal(12, 2)
  observaciones        String?              @db.Text
  estado               EstadoDetalleReserva @default(SOLICITADO)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reserva          Reserva          @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  productoSucursal ProductoSucursal @relation(fields: [productoSucursalId], references: [id], onDelete: Restrict)

  @@unique([reservaId, productoSucursalId])
  @@index([productoSucursalId])
  @@index([reservaId, estado])
  @@map("detalle_reserva")
}

model PagoReserva {
  id                String     @id @default(uuid()) @db.Uuid
  reservaId         String     @map("reserva_id") @db.Uuid
  registradoPorId   String     @map("registrado_por_id") @db.Uuid
  confirmadoPorId   String?    @map("confirmado_por_id") @db.Uuid
  metodoPago        MetodoPago @map("metodo_pago")
  monto             Decimal    @db.Decimal(12, 2)
  numeroOperacion   String?    @map("numero_operacion") @db.VarChar(100)
  estado            EstadoPago @default(PENDIENTE)
  fechaPago         DateTime   @default(now()) @map("fecha_pago") @db.Timestamptz(3)
  fechaConfirmacion DateTime?  @map("fecha_confirmacion") @db.Timestamptz(3)
  observaciones     String?    @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reserva       Reserva  @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  registradoPor Usuario  @relation("PagosReservaRegistrados", fields: [registradoPorId], references: [id], onDelete: Restrict)
  confirmadoPor Usuario? @relation("PagosReservaConfirmados", fields: [confirmadoPorId], references: [id], onDelete: Restrict)

  @@index([reservaId, estado])
  @@index([metodoPago, numeroOperacion])
  @@index([registradoPorId])
  @@index([confirmadoPorId])
  @@map("pago_reserva")
}

model HistorialReserva {
  id             String         @id @default(uuid()) @db.Uuid
  reservaId      String         @map("reserva_id") @db.Uuid
  usuarioId      String         @map("usuario_id") @db.Uuid
  estadoAnterior EstadoReserva? @map("estado_anterior")
  estadoNuevo    EstadoReserva  @map("estado_nuevo")
  observacion    String?        @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation("HistorialReservaUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([reservaId, createdAt])
  @@index([usuarioId, createdAt])
  @@map("historial_reserva")
}

// ======================================================
// PEDIDOS
// ======================================================

model Pedido {
  id            String       @id @default(uuid()) @db.Uuid
  codigo        String       @db.VarChar(30)
  sucursalId    String       @map("sucursal_id") @db.Uuid
  reservaId     String?      @unique @map("reserva_id") @db.Uuid
  clienteId     String?      @map("cliente_id") @db.Uuid
  vendedorId    String       @map("vendedor_id") @db.Uuid
  mozoId        String?      @map("mozo_id") @db.Uuid
  zonaId        String?      @map("zona_id") @db.Uuid
  tipoPedido    TipoPedido   @map("tipo_pedido")
  estado        EstadoPedido @default(ABIERTO)
  observaciones String?      @db.Text

  enviadoAt         DateTime? @map("enviado_at") @db.Timestamptz(3)
  pagadoAt          DateTime? @map("pagado_at") @db.Timestamptz(3)
  canceladoAt       DateTime? @map("cancelado_at") @db.Timestamptz(3)
  canceladoPorId    String?   @map("cancelado_por_id") @db.Uuid
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  reserva      Reserva? @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  cliente      Usuario? @relation("PedidosCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor     Usuario  @relation("PedidosVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  mozo         Usuario? @relation("PedidosMozo", fields: [mozoId], references: [id], onDelete: Restrict)
  zona         Zona?    @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  canceladoPor Usuario? @relation("PedidosCancelados", fields: [canceladoPorId], references: [id], onDelete: Restrict)

  detalles DetallePedido[]
  comandas Comanda[]
  entregas EntregaPedido[]
  venta    Venta?

  @@unique([sucursalId, codigo])
  @@index([sucursalId, estado, createdAt])
  @@index([clienteId, createdAt])
  @@index([vendedorId, createdAt])
  @@index([mozoId, estado])
  @@index([zonaId, estado])
  @@index([reservaId])
  @@map("pedido")
}

model DetallePedido {
  id                   String              @id @default(uuid()) @db.Uuid
  pedidoId             String              @map("pedido_id") @db.Uuid
  productoSucursalId   String              @map("producto_sucursal_id") @db.Uuid
  nombreProducto       String              @map("nombre_producto") @db.VarChar(150)
  cantidad             Decimal             @db.Decimal(12, 3)
  cantidadComprometida Decimal             @default(0) @map("cantidad_comprometida") @db.Decimal(12, 3)
  precioUnitario       Decimal             @map("precio_unitario") @db.Decimal(12, 2)
  subtotal             Decimal             @db.Decimal(12, 2)
  observaciones        String?             @db.Text
  estado               EstadoDetallePedido @default(PENDIENTE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedido           Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  productoSucursal ProductoSucursal @relation(fields: [productoSucursalId], references: [id], onDelete: Restrict)

  comandas DetalleComanda[]
  entregas DetalleEntrega[]

  @@index([pedidoId, estado])
  @@index([productoSucursalId])
  @@map("detalle_pedido")
}

// ======================================================
// COMANDAS: COCINA Y BARRA
// ======================================================

model Comanda {
  id             String           @id @default(uuid()) @db.Uuid
  codigo         String           @db.VarChar(30)
  sucursalId     String           @map("sucursal_id") @db.Uuid
  pedidoId       String           @map("pedido_id") @db.Uuid
  procesadoPorId String?          @map("procesado_por_id") @db.Uuid
  destino        DestinoComanda
  prioridad      PrioridadComanda @default(NORMAL)
  estado         EstadoComanda    @default(PENDIENTE)

  fechaInicio       DateTime? @map("fecha_inicio") @db.Timestamptz(3)
  fechaFinalizacion DateTime? @map("fecha_finalizacion") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  pedido       Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  procesadoPor Usuario? @relation("ComandasProcesadas", fields: [procesadoPorId], references: [id], onDelete: Restrict)

  detalles DetalleComanda[]

  @@unique([sucursalId, codigo])
  @@index([pedidoId])
  @@index([sucursalId, destino, estado, createdAt])
  @@index([procesadoPorId, estado])
