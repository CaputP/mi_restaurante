  fechaFin         DateTime? @map("fecha_fin") @db.Timestamptz(3)
  fechaEliminacion DateTime? @map("fecha_eliminacion") @db.Timestamptz(3)
  mensajeError     String?   @map("mensaje_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal      Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  solicitadoPor Usuario?  @relation("RespaldosSolicitadosPor", fields: [solicitadoPorId], references: [id], onDelete: Restrict)

  @@index([estado, createdAt])
  @@index([tipo, createdAt])
  @@index([solicitadoPorId])
  @@map("respaldo")
}

// ======================================================
// TOKENS DE SEGURIDAD
// ======================================================

model TokenVerificacionCorreo {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraAt  DateTime  @map("expira_at") @db.Timestamptz(3)
  usadoAt   DateTime? @map("usado_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiraAt])
  @@index([expiraAt, usadoAt])
  @@map("token_verificacion_correo")
}

model TokenRecuperacionPassword {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraAt  DateTime  @map("expira_at") @db.Timestamptz(3)
  usadoAt   DateTime? @map("usado_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiraAt])
  @@index([expiraAt, usadoAt])
  @@map("token_recuperacion_password")
}
