// ======================================================
// PROMOCIONES
// ======================================================

model Promocion {
  id          String  @id @default(uuid()) @db.Uuid
  sucursalId  String? @map("sucursal_id") @db.Uuid
  creadoPorId String  @map("creado_por_id") @db.Uuid

  nombre      String        @db.VarChar(160)
  descripcion String?       @db.Text
  tipo        TipoPromocion

  valor         Decimal @default(0) @db.Decimal(12, 2)
  consumoMinimo Decimal @default(0) @map("consumo_minimo") @db.Decimal(12, 2)

  automatica Boolean @default(true)
  acumulable Boolean @default(false)

  maximoUsos   Int? @map("maximo_usos")
  usosActuales Int  @default(0) @map("usos_actuales")

  fechaInicio DateTime @map("fecha_inicio") @db.Timestamptz(3)
  fechaFin    DateTime @map("fecha_fin") @db.Timestamptz(3)

  estado EstadoPromocion @default(BORRADOR)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal  Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  creadoPor Usuario   @relation("PromocionesCreadas", fields: [creadoPorId], references: [id], onDelete: Restrict)

  productos PromocionProducto[]
  ventas    VentaPromocion[]

  @@index([sucursalId, estado, fechaInicio, fechaFin])
  @@index([creadoPorId])
  @@map("promocion")
}

model PromocionProducto {
  promocionId String @map("promocion_id") @db.Uuid
  productoId  String @map("producto_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  promocion Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  producto  Producto  @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@id([promocionId, productoId])
  @@index([productoId])
  @@map("promocion_producto")
}

model VentaPromocion {
  id          String @id @default(uuid()) @db.Uuid
  ventaId     String @map("venta_id") @db.Uuid
  promocionId String @map("promocion_id") @db.Uuid

  descripcion    String  @db.VarChar(250)
  montoDescuento Decimal @map("monto_descuento") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  venta     Venta     @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  promocion Promocion @relation(fields: [promocionId], references: [id], onDelete: Restrict)

  @@unique([ventaId, promocionId])
  @@index([promocionId])
  @@map("venta_promocion")
}

// ======================================================
// CONFIGURACIÓN DEL SISTEMA
// ======================================================

model ConfiguracionSistema {
  id               String  @id @default(uuid()) @db.Uuid
  sucursalId       String? @map("sucursal_id") @db.Uuid
  actualizadoPorId String  @map("actualizado_por_id") @db.Uuid

