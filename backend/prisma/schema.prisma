}

model DetalleComanda {
  id              String               @id @default(uuid()) @db.Uuid
  comandaId       String               @map("comanda_id") @db.Uuid
  detallePedidoId String               @map("detalle_pedido_id") @db.Uuid
  cantidad        Decimal              @db.Decimal(12, 3)
  observaciones   String?              @db.Text
  estado          EstadoDetalleComanda @default(PENDIENTE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  comanda       Comanda       @relation(fields: [comandaId], references: [id], onDelete: Restrict)
  detallePedido DetallePedido @relation(fields: [detallePedidoId], references: [id], onDelete: Restrict)

  @@unique([comandaId, detallePedidoId])
  @@index([detallePedidoId])
  @@index([comandaId, estado])
  @@map("detalle_comanda")
}

// ======================================================
// ENTREGA DE PEDIDOS
// ======================================================

model EntregaPedido {
  id               String        @id @default(uuid()) @db.Uuid
  pedidoId         String        @map("pedido_id") @db.Uuid
  mozoId           String        @map("mozo_id") @db.Uuid
  tipoEntrega      TipoEntrega   @map("tipo_entrega")
  estado           EstadoEntrega @default(PENDIENTE)
  codigoValidacion String        @unique @map("codigo_validacion") @db.VarChar(20)
  fechaRetiro      DateTime?     @map("fecha_retiro") @db.Timestamptz(3)
  fechaEntrega     DateTime?     @map("fecha_entrega") @db.Timestamptz(3)
  observaciones    String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedido Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  mozo   Usuario @relation("EntregasMozo", fields: [mozoId], references: [id], onDelete: Restrict)

  detalles DetalleEntrega[]

  @@index([pedidoId, estado])
  @@index([mozoId, createdAt])
  @@index([estado, createdAt])
  @@map("entrega_pedido")
}

model DetalleEntrega {
  id                String  @id @default(uuid()) @db.Uuid
  entregaPedidoId   String  @map("entrega_pedido_id") @db.Uuid
  detallePedidoId   String  @map("detalle_pedido_id") @db.Uuid
  cantidadEntregada Decimal @map("cantidad_entregada") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entregaPedido EntregaPedido @relation(fields: [entregaPedidoId], references: [id], onDelete: Restrict)
  detallePedido DetallePedido @relation(fields: [detallePedidoId], references: [id], onDelete: Restrict)

  @@unique([entregaPedidoId, detallePedidoId])
  @@index([detallePedidoId])
  @@map("detalle_entrega")
}

// ======================================================
// CAJA
// ======================================================

model Caja {
  id           String  @id @default(uuid()) @db.Uuid
  codigo       String  @db.VarChar(30)
  sucursalId   String  @map("sucursal_id") @db.Uuid
  vendedorId   String  @map("vendedor_id") @db.Uuid
  abiertaPorId String  @map("abierta_por_id") @db.Uuid
  cerradaPorId String? @map("cerrada_por_id") @db.Uuid

  montoInicial       Decimal @default(0) @map("monto_inicial") @db.Decimal(12, 2)
  totalVentas        Decimal @default(0) @map("total_ventas") @db.Decimal(12, 2)
  totalEfectivo      Decimal @default(0) @map("total_efectivo") @db.Decimal(12, 2)
  totalYape          Decimal @default(0) @map("total_yape") @db.Decimal(12, 2)
  totalPlin          Decimal @default(0) @map("total_plin") @db.Decimal(12, 2)
  totalTarjeta       Decimal @default(0) @map("total_tarjeta") @db.Decimal(12, 2)
  totalTransferencia Decimal @default(0) @map("total_transferencia") @db.Decimal(12, 2)
  totalGastosCaja    Decimal @default(0) @map("total_gastos_caja") @db.Decimal(12, 2)

  efectivoEsperado Decimal  @default(0) @map("efectivo_esperado") @db.Decimal(12, 2)
  efectivoContado  Decimal? @map("efectivo_contado") @db.Decimal(12, 2)
  diferencia       Decimal? @db.Decimal(12, 2)

  estado        EstadoCaja @default(ABIERTA)
  fechaApertura DateTime   @default(now()) @map("fecha_apertura") @db.Timestamptz(3)
  fechaCierre   DateTime?  @map("fecha_cierre") @db.Timestamptz(3)
  observaciones String?    @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  vendedor   Usuario  @relation("CajasVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  abiertaPor Usuario  @relation("CajasAbiertasPor", fields: [abiertaPorId], references: [id], onDelete: Restrict)
  cerradaPor Usuario? @relation("CajasCerradasPor", fields: [cerradaPorId], references: [id], onDelete: Restrict)

  ventas Venta[]
  gastos Gasto[]

  @@unique([sucursalId, codigo])
  @@index([sucursalId, estado, fechaApertura])
  @@index([vendedorId, estado])
  @@index([abiertaPorId])
  @@index([cerradaPorId])
  @@map("caja")
}

// ======================================================
// VENTAS
// ======================================================

model Venta {
  id           String  @id @default(uuid()) @db.Uuid
  numeroTicket String  @map("numero_ticket") @db.VarChar(30)
  pedidoId     String  @unique @map("pedido_id") @db.Uuid
  clienteId    String? @map("cliente_id") @db.Uuid
  sucursalId   String  @map("sucursal_id") @db.Uuid
  vendedorId   String  @map("vendedor_id") @db.Uuid
  cajaId       String  @map("caja_id") @db.Uuid

  nombreCliente String? @map("nombre_cliente") @db.VarChar(200)

  subtotal         Decimal @db.Decimal(12, 2)
  descuento        Decimal @default(0) @db.Decimal(12, 2)
  propina          Decimal @default(0) @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)
  adelantoAplicado Decimal @default(0) @map("adelanto_aplicado") @db.Decimal(12, 2)
  saldoCobrar      Decimal @map("saldo_cobrar") @db.Decimal(12, 2)

  estado        EstadoVenta @default(CONFIRMADA)
  observaciones String?     @db.Text

  anuladaAt       DateTime? @map("anulada_at") @db.Timestamptz(3)
  anuladaPorId    String?   @map("anulada_por_id") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  cliente    Usuario? @relation("VentasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  vendedor   Usuario  @relation("VentasVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  caja       Caja     @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  anuladaPor Usuario? @relation("VentasAnuladasPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)

  detalles                DetalleVenta[]
  pagos                   PagoVenta[]
  premiosCanjeados        PremioCliente[]
  canjesPremios           CanjePremioCliente[]
  promocionesAplicadas    VentaPromocion[]
  movimientosFidelizacion MovimientoFidelizacion[]
  resena                  Resena?

  @@unique([sucursalId, numeroTicket])
  @@index([sucursalId, createdAt])
  @@index([vendedorId, createdAt])
  @@index([clienteId, createdAt])
  @@index([cajaId, estado])
  @@index([estado, createdAt])
  @@map("venta")
}

model DetalleVenta {
  id                 String  @id @default(uuid()) @db.Uuid
  ventaId            String  @map("venta_id") @db.Uuid
  productoSucursalId String  @map("producto_sucursal_id") @db.Uuid
  nombreProducto     String  @map("nombre_producto") @db.VarChar(150)
  cantidad           Decimal @db.Decimal(12, 3)
  precioUnitario     Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal           Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  venta            Venta            @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  productoSucursal ProductoSucursal @relation(fields: [productoSucursalId], references: [id], onDelete: Restrict)

  @@index([ventaId])
  @@index([productoSucursalId])
  @@map("detalle_venta")
}

model PagoVenta {
  id              String     @id @default(uuid()) @db.Uuid
  ventaId         String     @map("venta_id") @db.Uuid
  metodoPago      MetodoPago @map("metodo_pago")
  monto           Decimal    @db.Decimal(12, 2)
  numeroOperacion String?    @map("numero_operacion") @db.VarChar(100)

  montoRecibido Decimal? @map("monto_recibido") @db.Decimal(12, 2)
  vuelto        Decimal? @db.Decimal(12, 2)

  estado EstadoPago @default(CONFIRMADO)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  @@index([ventaId, estado])
  @@index([metodoPago, createdAt])
  @@index([numeroOperacion])
  @@map("pago_venta")
}

// ======================================================
// GASTOS
// ======================================================

model CategoriaGasto {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.Text
  activo      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gastos Gasto[]

  @@index([activo])
  @@map("categoria_gasto")
}

model Gasto {
  id               String  @id @default(uuid()) @db.Uuid
  sucursalId       String  @map("sucursal_id") @db.Uuid
  categoriaGastoId String  @map("categoria_gasto_id") @db.Uuid
  administradorId  String  @map("administrador_id") @db.Uuid
  cajaId           String? @map("caja_id") @db.Uuid

  descripcion    String     @db.Text
  monto          Decimal    @db.Decimal(12, 2)
  metodoPago     MetodoPago @map("metodo_pago")
  salioDeCaja    Boolean    @default(false) @map("salio_de_caja")
  comprobanteUrl String?    @map("comprobante_url") @db.VarChar(500)
  fechaGasto     DateTime   @default(now()) @map("fecha_gasto") @db.Timestamptz(3)

  estado EstadoGasto @default(REGISTRADO)

  anuladoPorId    String?   @map("anulado_por_id") @db.Uuid
  anuladoAt       DateTime? @map("anulado_at") @db.Timestamptz(3)
  motivoAnulacion String?   @map("motivo_anulacion") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal       Sucursal       @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  categoriaGasto CategoriaGasto @relation(fields: [categoriaGastoId], references: [id], onDelete: Restrict)
  administrador  Usuario        @relation("GastosRegistradosPor", fields: [administradorId], references: [id], onDelete: Restrict)
  caja           Caja?          @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  anuladoPor     Usuario?       @relation("GastosAnuladosPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)

  @@index([sucursalId, fechaGasto])
  @@index([categoriaGastoId, fechaGasto])
  @@index([administradorId])
  @@index([cajaId])
  @@index([estado, fechaGasto])
  @@map("gasto")
}

// ======================================================
// FIDELIZACIÓN DE CLIENTES
// ======================================================

model ProgramaFidelizacion {
  id          String  @id @default(uuid()) @db.Uuid
  sucursalId  String? @map("sucursal_id") @db.Uuid
  creadoPorId String  @map("creado_por_id") @db.Uuid

  nombre      String  @db.VarChar(160)
  descripcion String? @db.Text

  tipo              TipoProgramaFidelizacion
  visitasRequeridas Int?                     @map("visitas_requeridas")
  montoRequerido    Decimal?                 @map("monto_requerido") @db.Decimal(12, 2)

  tipoRecompensa       TipoRecompensa @map("tipo_recompensa")
  productoPremioId     String?        @map("producto_premio_id") @db.Uuid
  cantidadPremio       Decimal?       @map("cantidad_premio") @db.Decimal(12, 3)
  montoDescuento       Decimal?       @map("monto_descuento") @db.Decimal(12, 2)
  porcentajeDescuento  Decimal?       @map("porcentaje_descuento") @db.Decimal(5, 2)
  descripcionBeneficio String?        @map("descripcion_beneficio") @db.VarChar(250)

  vigenciaDiasPremio Int     @default(30) @map("vigencia_dias_premio")
  automatico         Boolean @default(true)
  activo             Boolean @default(true)

  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime? @map("fecha_fin") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sucursal       Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  creadoPor      Usuario   @relation("ProgramasFidelizacionCreados", fields: [creadoPorId], references: [id], onDelete: Restrict)
  productoPremio Producto? @relation("ProductoPremioPrograma", fields: [productoPremioId], references: [id], onDelete: Restrict)

  progresos   ProgresoFidelizacion[]
  premios     PremioCliente[]
  movimientos MovimientoFidelizacion[]

  @@index([sucursalId, activo, fechaInicio, fechaFin])
  @@index([tipo, activo])
  @@index([creadoPorId])
  @@map("programa_fidelizacion")
}

model ProgresoFidelizacion {
  id         String @id @default(uuid()) @db.Uuid
  clienteId  String @map("cliente_id") @db.Uuid
  programaId String @map("programa_id") @db.Uuid

  visitasAcumuladas Int     @default(0) @map("visitas_acumuladas")
  montoAcumulado    Decimal @default(0) @map("monto_acumulado") @db.Decimal(12, 2)
  ciclosCompletados Int     @default(0) @map("ciclos_completados")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente  Usuario              @relation("ProgresoFidelizacionCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  programa ProgramaFidelizacion @relation(fields: [programaId], references: [id], onDelete: Restrict)

  movimientos MovimientoFidelizacion[]

  @@unique([clienteId, programaId])
  @@index([programaId])
  @@index([clienteId, updatedAt])
  @@map("progreso_fidelizacion")
}

model MovimientoFidelizacion {
  id         String @id @default(uuid()) @db.Uuid
  ventaId    String @map("venta_id") @db.Uuid
  clienteId  String @map("cliente_id") @db.Uuid
  programaId String @map("programa_id") @db.Uuid
  progresoId String @map("progreso_id") @db.Uuid

  visitasAplicadas Int     @default(0) @map("visitas_aplicadas")
  montoAplicado    Decimal @default(0) @map("monto_aplicado") @db.Decimal(12, 2)
  ciclosGenerados  Int     @default(0) @map("ciclos_generados")

  estado EstadoRegistro @default(ACTIVO)

  revertidoAt     DateTime? @map("revertido_at") @db.Timestamptz(3)
  revertidoPorId  String?   @map("revertido_por_id") @db.Uuid
  motivoReversion String?   @map("motivo_reversion") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  venta    Venta                @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  cliente  Usuario              @relation("MovimientosFidelizacionCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  programa ProgramaFidelizacion @relation(fields: [programaId], references: [id], onDelete: Restrict)
  progreso ProgresoFidelizacion @relation(fields: [progresoId], references: [id], onDelete: Restrict)

  revertidoPor Usuario? @relation("MovimientosFidelizacionRevertidosPor", fields: [revertidoPorId], references: [id], onDelete: Restrict)

  premios PremioCliente[]

  @@unique([ventaId, programaId])
  @@index([clienteId, createdAt])
  @@index([programaId, estado])
  @@index([progresoId])
  @@index([revertidoPorId])
  @@map("movimiento_fidelizacion")
}

model PremioCliente {
  id               String  @id @default(uuid()) @db.Uuid
  clienteId        String  @map("cliente_id") @db.Uuid
  programaId       String  @map("programa_id") @db.Uuid
  productoPremioId String? @map("producto_premio_id") @db.Uuid
  ventaCanjeId     String? @map("venta_canje_id") @db.Uuid
  canjeadoPorId    String? @map("canjeado_por_id") @db.Uuid
  movimientoId     String? @map("movimiento_id") @db.Uuid

  tipoRecompensaSnapshot TipoRecompensa? @map("tipo_recompensa_snapshot")
  montoAplicado          Decimal?        @map("monto_aplicado") @db.Decimal(12, 2)

  descripcion      String   @db.VarChar(250)
  cantidadProducto Decimal? @map("cantidad_producto") @db.Decimal(12, 3)
  valorReferencia  Decimal? @map("valor_referencia") @db.Decimal(12, 2)

  estado EstadoPremio @default(DISPONIBLE)

  fechaObtencion   DateTime  @default(now()) @map("fecha_obtencion") @db.Timestamptz(3)
  fechaVencimiento DateTime  @map("fecha_vencimiento") @db.Timestamptz(3)
  fechaCanje       DateTime? @map("fecha_canje") @db.Timestamptz(3)
  motivoAnulacion  String?   @map("motivo_anulacion") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente        Usuario              @relation("PremiosCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  programa       ProgramaFidelizacion @relation(fields: [programaId], references: [id], onDelete: Restrict)
  productoPremio Producto?            @relation("ProductoPremioEmitido", fields: [productoPremioId], references: [id], onDelete: Restrict)
  ventaCanje     Venta?               @relation(fields: [ventaCanjeId], references: [id], onDelete: Restrict)
  canjeadoPor    Usuario?             @relation("PremiosCanjeadosPor", fields: [canjeadoPorId], references: [id], onDelete: Restrict)

  canjes CanjePremioCliente[]

  movimiento MovimientoFidelizacion? @relation(fields: [movimientoId], references: [id], onDelete: Restrict)

  @@index([clienteId, estado, fechaVencimiento])
  @@index([programaId])
  @@index([ventaCanjeId])
  @@index([productoPremioId])
  @@index([movimientoId])
  @@map("premio_cliente")
}

model CanjePremioCliente {
  id            String @id @default(uuid()) @db.Uuid
  premioId      String @map("premio_id") @db.Uuid
  ventaId       String @map("venta_id") @db.Uuid
  clienteId     String @map("cliente_id") @db.Uuid
  canjeadoPorId String @map("canjeado_por_id") @db.Uuid

  tipoRecompensa TipoRecompensa @map("tipo_recompensa")
  descripcion    String         @db.VarChar(250)
  montoAplicado  Decimal        @map("monto_aplicado") @db.Decimal(12, 2)

  productoPremioNombre String? @map("producto_premio_nombre") @db.VarChar(160)

  estado EstadoCanjePremio @default(APLICADO)

  fechaCanje DateTime @default(now()) @map("fecha_canje") @db.Timestamptz(3)

  revertidoAt     DateTime? @map("revertido_at") @db.Timestamptz(3)
  revertidoPorId  String?   @map("revertido_por_id") @db.Uuid
  motivoReversion String?   @map("motivo_reversion") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  premio PremioCliente @relation(fields: [premioId], references: [id], onDelete: Restrict)
  venta  Venta         @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  cliente      Usuario  @relation("CanjesPremioCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  canjeadoPor  Usuario  @relation("CanjesPremioRealizadosPor", fields: [canjeadoPorId], references: [id], onDelete: Restrict)
  revertidoPor Usuario? @relation("CanjesPremioRevertidosPor", fields: [revertidoPorId], references: [id], onDelete: Restrict)

  @@unique([premioId, ventaId])
  @@index([ventaId, estado])
  @@index([premioId, fechaCanje])
  @@index([clienteId, fechaCanje])
  @@index([canjeadoPorId])
  @@index([revertidoPorId])
  @@map("canje_premio_cliente")
