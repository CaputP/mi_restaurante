NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:change-me@localhost:5432/vallecito
FRONTEND_URL=http://localhost:5173

# Generar con: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-48-random-characters
JWT_EXPIRES_IN_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

EMAIL_MODE=console
MAIL_FROM=El Vallecito de Chocco <no-reply@example.com>
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
RESERVATION_CLIENT_CANCELLATION_HOURS=1
LEGAL_CONTACT_EMAIL=elvallecitodechocco@gmail.com
CONSUMER_CLAIMS_NOTIFICATION_EMAIL=elvallecitodechocco@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Ajustar al número de proxies confiables delante de Express.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_HEADERS_TIMEOUT_MS=15000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000

BACKUP_ENABLED=false
BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
